# These values are safe to expose in a browser bundle. RLS and database functions
# enforce authorization; never put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional CAPTCHA token for anonymous-player abuse protection.
VITE_TURNSTILE_SITE_KEY=
